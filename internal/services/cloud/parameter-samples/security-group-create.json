{
  "targetSpec": {
    "name": "my-security-group",
    "description": "My security group",
    "location": {
      "region": "GRA11"
    },
    "rules": [
      {
        "description": "Allow inbound SSH",
        "direction": "INGRESS",
        "ethernetType": "IPV4",
